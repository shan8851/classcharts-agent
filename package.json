{
  "name": "@shan8851/classcharts-agent",
  "version": "0.3.0",
  "description": "Read-only ClassCharts CLI for AI agents: homework, timetable, announcements, behaviour, detentions and attendance for a parent account.",
  "license": "MIT",
  "author": "Asam Shan",
  "homepage": "https://github.com/shan8851/classcharts-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shan8851/classcharts-agent.git"
  },
  "bugs": "https://github.com/shan8851/classcharts-agent/issues",
  "keywords": [
    "classcharts",
    "school",
    "homework",
    "timetable",
    "parents",
    "cli",
    "ai-agent",
    "agents",
    "agent-skills"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "classcharts": "dist/cli.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cli": "node src/cli.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
